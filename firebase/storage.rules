rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isValidImage() {
      return request.resource.contentType.matches('image/(jpeg|png|webp)')
             && request.resource.size < 5 * 1024 * 1024; // 5MB limit
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isBusinessOwner() {
      return isAuthenticated() && (request.auth.token.role == 'owner' || request.auth.token.role == 'admin');
    }

    // Public Assets (Read-only)
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.token.role == 'admin';
    }

    // User Profile Photos
    match /profiles/{userId}/{fileName} {
      allow read: if true;
      allow write: if isOwner(userId) && isValidImage();
    }

    // Venue & Service Photos (Halls, Cars, Tents, Decor)
    match /listings/{listingId}/{fileName} {
      allow read: if true;
      allow write: if isBusinessOwner() && isValidImage();
    }

    // Optional 3D Venue Models (Section 12)
    match /models/{listingId}/{fileName} {
      allow read: if true;
      allow write: if isBusinessOwner() && request.resource.size < 20 * 1024 * 1024; // 20MB for 3D GLB
    }

    // Review Photos
    match /reviews/{reviewId}/{fileName} {
      allow read: if true;
      allow write: if isAuthenticated() && isValidImage();
    }
  }
}
