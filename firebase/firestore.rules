rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================================
    // HELPER FUNCTIONS & AUTHENTICATION PREDICATES
    // =========================================================================
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && request.auth.token.role == 'admin';
    }
    
    function isBusinessOwner() {
      return isAuthenticated() && (request.auth.token.role == 'owner' || request.auth.token.role == 'admin');
    }
    
    function isStaff() {
      return isAuthenticated() && (request.auth.token.role == 'staff' || isBusinessOwner());
    }

    // =========================================================================
    // USERS COLLECTION
    // Rule: Users cannot self-escalate their role or set themselves as verified.
    // =========================================================================
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() 
                    && request.auth.uid == userId
                    && (!('role' in request.resource.data) || request.resource.data.role in ['user', 'customer', 'owner'])
                    && (!('isVerified' in request.resource.data) || request.resource.data.isVerified == false);
      allow update: if (isOwner(userId) 
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isVerified', 'id', 'email']))
                    || isAdmin();
      allow delete: if isAdmin();
    }

    // =========================================================================
    // OWNERS & PROFILES COLLECTION
    // =========================================================================
    match /owners/{ownerId} {
      allow read: if true;
      allow create: if isBusinessOwner();
      allow update: if (isOwner(resource.data.userId) 
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verificationStatus', 'rating']))
                    || isAdmin();
      allow delete: if isAdmin();
    }

    // =========================================================================
    // LISTINGS COLLECTIONS (Halls, Cars, Tent Houses, Services)
    // Rule: Public can read APPROVED listings. Owners can edit their own.
    // =========================================================================
    match /halls/{hallId} {
      allow read: if resource.data.status == 'APPROVED' 
                  || (isAuthenticated() && resource.data.ownerId == request.auth.uid) 
                  || isAdmin();
      allow create: if isBusinessOwner() 
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.startingPrice is number
                    && request.resource.data.startingPrice > 0;
      allow update: if (isBusinessOwner() 
                        && resource.data.ownerId == request.auth.uid
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verified', 'ownerId']))
                    || isAdmin();
      allow delete: if (isBusinessOwner() && resource.data.ownerId == request.auth.uid) || isAdmin();
    }

    match /cars/{carId} {
      allow read: if resource.data.status == 'APPROVED' 
                  || (isAuthenticated() && resource.data.ownerId == request.auth.uid) 
                  || isAdmin();
      allow create: if isBusinessOwner() && request.resource.data.ownerId == request.auth.uid;
      allow update: if (isBusinessOwner() && resource.data.ownerId == request.auth.uid) || isAdmin();
      allow delete: if (isBusinessOwner() && resource.data.ownerId == request.auth.uid) || isAdmin();
    }

    match /tent_houses/{tentId} {
      allow read: if resource.data.status == 'APPROVED' 
                  || (isAuthenticated() && resource.data.ownerId == request.auth.uid) 
                  || isAdmin();
      allow create: if isBusinessOwner() && request.resource.data.ownerId == request.auth.uid;
      allow update: if (isBusinessOwner() && resource.data.ownerId == request.auth.uid) || isAdmin();
      allow delete: if (isBusinessOwner() && resource.data.ownerId == request.auth.uid) || isAdmin();
    }

    match /services/{serviceId} {
      allow read: if resource.data.status == 'APPROVED' 
                  || (isAuthenticated() && resource.data.ownerId == request.auth.uid) 
                  || isAdmin();
      allow create: if isBusinessOwner() && request.resource.data.ownerId == request.auth.uid;
      allow update: if (isBusinessOwner() && resource.data.ownerId == request.auth.uid) || isAdmin();
      allow delete: if (isBusinessOwner() && resource.data.ownerId == request.auth.uid) || isAdmin();
    }

    // =========================================================================
    // STAFF COLLECTION (Section 33)
    // Rule: Staff cannot grant themselves owner permissions.
    // =========================================================================
    match /staff/{staffId} {
      allow read: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || resource.data.userId == request.auth.uid || isAdmin());
      allow create, update, delete: if isBusinessOwner() && (request.resource.data.ownerId == request.auth.uid || resource.data.ownerId == request.auth.uid) || isAdmin();
    }

    // =========================================================================
    // BOOKINGS COLLECTION (Section 14 & 19)
    // Rule: Only participants can read. Status changes restricted to owner/admin.
    // =========================================================================
    match /bookings/{bookingId} {
      allow read: if isAuthenticated() 
                  && (resource.data.customerId == request.auth.uid 
                      || resource.data.ownerId == request.auth.uid 
                      || isStaff() 
                      || isAdmin());
      allow create: if isAuthenticated() 
                    && request.resource.data.customerId == request.auth.uid
                    && request.resource.data.status == 'REQUESTED';
      allow update: if (isBusinessOwner() && resource.data.ownerId == request.auth.uid)
                    || (isAuthenticated() && resource.data.customerId == request.auth.uid && request.resource.data.status == 'CANCELLED')
                    || isAdmin();
      allow delete: if isAdmin();
    }

    // =========================================================================
    // REVIEWS COLLECTION (Section 28)
    // Rule: Only completed bookings can create reviews.
    // =========================================================================
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() 
                    && request.resource.data.customerId == request.auth.uid
                    && request.resource.data.rating >= 1 
                    && request.resource.data.rating <= 5;
      allow update, delete: if (isAuthenticated() && resource.data.customerId == request.auth.uid) || isAdmin();
    }

    // =========================================================================
    // NOTIFICATIONS & FAVORITES
    // =========================================================================
    match /notifications/{notificationId} {
      allow read, update: if isAuthenticated() && resource.data.recipientId == request.auth.uid;
      allow create: if isAuthenticated();
      allow delete: if isAuthenticated() && resource.data.recipientId == request.auth.uid;
    }

    match /favorites/{favoriteId} {
      allow read, write: if isAuthenticated() && (resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid);
    }

    // =========================================================================
    // VERIFICATION REQUESTS (Section 35)
    // =========================================================================
    match /verification_requests/{requestId} {
      allow read: if (isAuthenticated() && resource.data.ownerId == request.auth.uid) || isAdmin();
      allow create: if isBusinessOwner() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // ADMIN ONLY COLLECTION
    // =========================================================================
    match /admin_users/{adminId} {
      allow read, write: if isAdmin();
    }
  }
}
