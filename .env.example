# ==============================================================================
# HALL KHOJ FINDER — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

# Application URLs
APP_URL=https://hallkhoj.in
FRONTEND_URL=https://hallkhoj.in
BACKEND_URL=https://api.hallkhoj.in
PORT=3000
NODE_ENV=production

# 1. Supabase Cloud Configuration (PostgreSQL, Auth, Storage, Realtime)
# Get credentials: https://supabase.com/dashboard/project/<ref>/settings/api
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_service_role_key_here

# 2. Razorpay Payment Gateway (Server-Side HMAC-SHA256 Verification)
# Get keys: https://dashboard.razorpay.com/#/app/keys
RAZORPAY_KEY_ID=rzp_test_or_live_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
PAYMENT_KEY_ID=rzp_test_or_live_your_key_id_here
PAYMENT_KEY_SECRET=your_razorpay_key_secret_here

# 3. JWT Authentication Secret (64+ Character Random Secret)
AUTH_SECRET=generate_strong_64_character_random_secret_for_production_here

# 4. Google Gemini AI Engine (NLP Search & Conversational Assistant)
# Get free API key: https://aistudio.google.com/app/apikey
AI_API_KEY=your_gemini_api_key_here

# 5. Communications & Notifications
EMAIL_API_KEY=your_resend_or_sendgrid_key_here
SMS_API_KEY=your_sms_gateway_key_here
GOOGLE_MAPS_API_KEY=your_google_maps_platform_api_key_here
